# Web uygulaması (derleme sırasında gömülür; Cloudflare "Build variables" bölümüne de girilmeli)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PLAY_PACKAGE=com.example.paket
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Gizli anahtarlar SADECE Supabase Edge Function secrets içine girilir (siteye/Cloudflare'e değil):
#   GOOGLE_PLAY_SERVICE_ACCOUNT_JSON  (servis hesabı JSON'unun tamamı)
#   PLAY_PACKAGE_NAME                 (Play paket adı)
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY Supabase tarafından otomatik sağlanır.

# Bildirimler (Web Push / VAPID) - anahtar çifti: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=            # herkese açık anahtar (Cloudflare Build variables'a da girin)
# VAPID_PRIVATE_KEY ve VAPID_SUBJECT (mailto:siz@ornek.com) -> SADECE Supabase secrets'a girin (ADIM 3)
